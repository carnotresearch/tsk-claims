# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# Async URL used at runtime (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://hsk:hsk@localhost:5432/hsk_claims
# Sync URL used by Alembic migrations only (psycopg3 driver)
DATABASE_URL_SYNC=postgresql+psycopg://hsk:hsk@localhost:5432/hsk_claims

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM — modular (swap by changing LLM_PROVIDER) ────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── Sync pipeline ─────────────────────────────────────────────────────────────
SYNC_SOURCE=upload
EXCEL_FILE_PATH=/app/uploads/latest.xlsx
SYNC_SCHEDULE=0 */6 * * *

# ── Upload storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Admin seed (used by alembic seed script) ──────────────────────────────────
ADMIN_EMAIL=admin@hsk.local
ADMIN_PASSWORD=changeme
ADMIN_FULL_NAME=HSK Admin
