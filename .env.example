# ── Database ──────────────────────────────────────────────
POSTGRES_DB=hsk_claims
POSTGRES_USER=hsk
POSTGRES_PASSWORD=changeme_strong_password

# ── App ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_real_secret_key

# ── AI / Chat ─────────────────────────────────────────────
# LLM provider: gemini (default) | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# ── Sync pipeline ─────────────────────────────────────────
# 'upload'       → manual file upload via API (default)
# 'local_file'   → watch a file path on the container filesystem
# 'google_drive' → future
# 'network_share'→ future
SYNC_SOURCE=upload

# Path used when SYNC_SOURCE=local_file
EXCEL_FILE_PATH=/app/uploads/latest.xlsx

# Cron expression for scheduled sync (APScheduler, when SYNC_SOURCE != upload)
# Default: every 6 hours
SYNC_SCHEDULE=0 */6 * * *

# ── Docker Hub ────────────────────────────────────────────
# Your Docker Hub username (used in docker-compose.prod.yml image tags)
DOCKER_USER=pranavkanire

# ── Misc ──────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=production

# Admin seed (used by scripts/seed_admin.py)
ADMIN_EMAIL=admin@hsk.local
ADMIN_PASSWORD=changeme_admin_password
ADMIN_FULL_NAME=HSK Admin
